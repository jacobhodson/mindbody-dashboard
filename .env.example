# Copy this to .env for local development.
# In Netlify: add these under Site Settings → Environment Variables.

# ── Mindbody API ─────────────────────────────────────────────────────────────
# Create an API key at https://developers.mindbodyonline.com
MINDBODY_API_KEY=your_api_key_here

# Your Mindbody site/studio ID (negative IDs are sandbox; positive = production)
MINDBODY_SITE_ID=-99

# Staff account credentials used to generate API tokens.
# Create a dedicated staff account with read-only API access for security.
MINDBODY_USERNAME=api@yourgym.com
MINDBODY_PASSWORD=your_staff_password

# ── Notion ───────────────────────────────────────────────────────────────────
# Create an internal integration at https://www.notion.so/my-integrations
# then share each database below with that integration.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 32-character database IDs from Notion page URLs.
# See README.md for the required fields in each database.
NOTION_CLIENTS_DB=
NOTION_CONTACT_LOG_DB=
NOTION_ROLLOVER_DB=
NOTION_PAYMENT_RESOLUTIONS_DB=

# ── Branding ─────────────────────────────────────────────────────────────────
# Shown in the dashboard header and baked into onboarding script templates.
# Must be prefixed with VITE_ so the build can expose it to the frontend.
VITE_BUSINESS_NAME=Your Gym Name
